from collections import Counter

# English letter frequency (approx %)
english_freq = {
    'E':12.7,'T':9.1,'A':8.2,'O':7.5,'I':7.0,'N':6.7,'S':6.3,'H':6.1,'R':6.0,
    'D':4.3,'L':4.0,'C':2.8,'U':2.8,'M':2.4,'W':2.4,'F':2.2,'G':2.0,'Y':2.0,
    'P':1.9,'B':1.5,'V':1.0,'K':0.8,'J':0.2,'X':0.2,'Q':0.1,'Z':0.1
}

def decrypt(cipher, shift):
    return ''.join(chr(((ord(c)-65-shift)%26)+65) if c.isalpha() else c for c in cipher.upper())

def score(text):
    counts = Counter([c for c in text if c.isalpha()])
    total = sum(counts.values())
    if total == 0: return float('inf')
    diff = 0
    for letter, freq in english_freq.items():
        observed = (counts[letter]/total)*100 if letter in counts else 0
        diff += abs(observed - freq)
    return diff

def frequency_attack(cipher, top_n=10):
    results = []
    for shift in range(26):
        plain = decrypt(cipher, shift)
        results.append((score(plain), shift, plain))
    results.sort(key=lambda x: x[0])
    for i in range(top_n):
        print(f"Shift {results[i][1]}: {results[i][2]}")

# Example usage
ciphertext = "WKH TXLFN EURZQ IRA MXPSV RYHU WKH ODCB GRJ"
frequency_attack(ciphertext, top_n=10)
