def matrix(key):
    key = key.upper().replace("J","I")
    s = ""
    for c in key + "ABCDEFGHIKLMNOPQRSTUVWXYZ":
        if c not in s:
            s += c
    return [list(s[i:i+5]) for i in range(0,25,5)]

def pos(m,ch):
    for i in range(5):
        for j in range(5):
            if m[i][j] == ch:
                return i,j

key = input("Enter Key: ")
text = "KXJEYUREBEZWEHEWRYTUHEYFSKREHEGOYFIWTTTUOLKSYCAJPOBOTEIZONTXBYBNTGONEYCUZWRGDSONSXBOUYWRHEBAAHYUSEDQ"

m = matrix(key)
plain = ""

for i in range(0,len(text),2):
    r1,c1 = pos(m,text[i])
    r2,c2 = pos(m,text[i+1])

    if r1 == r2:
        plain += m[r1][(c1-1)%5] + m[r2][(c2-1)%5]
    elif c1 == c2:
        plain += m[(r1-1)%5][c1] + m[(r2-1)%5][c2]
    else:
        plain += m[r1][c2] + m[r2][c1]

print("Plain Text:")
print(plain)
