def matrix(key):
    key = key.upper().replace("J", "I")
    s = ""
    for c in key + "ABCDEFGHIKLMNOPQRSTUVWXYZ":
        if c not in s:
            s += c
    return [list(s[i:i+5]) for i in range(0, 25, 5)]

def pos(m, ch):
    for i in range(5):
        for j in range(5):
            if m[i][j] == ch:
                return i, j

key = input("Key: ")
text = input("Text: ").upper().replace("J", "I").replace(" ", "")

p = ""
i = 0
while i < len(text):
    a = text[i]
    b = text[i+1] if i+1 < len(text) else "X"
    if a == b:
        b = "X"
        i += 1
    else:
        i += 2
    p += a + b

m = matrix(key)
cipher = ""

for i in range(0, len(p), 2):
    r1, c1 = pos(m, p[i])
    r2, c2 = pos(m, p[i+1])

    if r1 == r2:
        cipher += m[r1][(c1+1)%5] + m[r2][(c2+1)%5]
    elif c1 == c2:
        cipher += m[(r1+1)%5][c1] + m[(r2+1)%5][c2]
    else:
        cipher += m[r1][c2] + m[r2][c1]

print("Cipher Text:", cipher)
